{
  "name": "flowloop",
  "version": "1.1.1",
  "description": "Rol bazlı AI geliştirme ekibi: analist → developer ⇄ reviewer → committer. Claude Agent SDK üzerinde, yetkileri kodla zorlanan iş akışı.",
  "type": "module",
  "bin": { "flowloop": "dist/src/cli.js", "kgflow": "dist/src/cli.js" },
  "files": ["dist/src", "templates", "install.sh", "KULLANIM.md", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p . && chmod +x dist/src/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build",
    "release": "npm test && npm version"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "picomatch": "^4.0.2",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.6.0"
  },
  "license": "UNLICENSED",
  "private": true
}
